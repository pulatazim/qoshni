# Nusxa oling: cp .env.example .env  (bu fayl repo'ga tushmaydi)

# --- Ma'lumotlar bazasi (docker compose + backend) ---
POSTGRES_USER=qoshni
POSTGRES_PASSWORD=qoshni
POSTGRES_DB=qoshni
DATABASE_URL=postgresql+asyncpg://qoshni:qoshni@postgres:5432/qoshni

# Docker host'da (compose tarmogidan tashqari) ishlatilsa:
# DATABASE_URL=postgresql+asyncpg://qoshni:qoshni@localhost:5432/qoshni

REDIS_URL=redis://redis:6379/0

# --- Iloha ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Autentifikatsiya (2-haftadan) ---
# BotFather tokeni — initData imzosini tekshirish uchun. HECH QACHON repo'ga tushmaydi.
TELEGRAM_BOT_TOKEN=
# JWT kaliti. Uzun tasodifiy qator yasang:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
INIT_DATA_MAX_AGE_SECONDS=86400
JWT_TTL_DAYS=7

# --- Cheklovlar (spam va suiiste'moldan himoya) ---
# redis — production va docker compose; memory — Redis'siz lokal ish/test.
RATE_LIMIT_BACKEND=redis
API_REQUESTS_PER_MINUTE=60
LISTINGS_PER_DAY=20

# --- Rasm va zaxira (4-haftadan, 15-haftagacha kerak emas) ---
# Kalitlar to'lsa rasmlar R2'ga yoziladi, aks holda jarayon xotirasida saqlanadi
# (lokal ish va testlar shu holda ham yuradi). R2_PUBLIC_BASE_URL — bucket'ning
# ommaviy manzili (pub-xxxx.r2.dev yoki o'z domeningiz).
# R2_ACCOUNT_ID=
# R2_BUCKET=qoshni
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=

# --- Domen (nginx + Let's Encrypt) ---
# A yozuvi shu domenga VM IP'sini ko'rsatishi kerak. Nginx sayt konfiguratsiyasi
# SITE_DOMAIN ni ikki joyda ishlatadi: server_name va sertifikat papkasi
# /etc/letsencrypt/live/<SITE_DOMAIN>/.
# SITE_DOMAIN=qoshni.example.com

# --- Mini App (webapp/) ---
# `docker compose up -d webapp` → http://localhost:5173
# Vite `/api` so'rovlarini QOSHNI_API_TARGET'ga proksilaydi (compose'da http://api:8000).
# Node host'da bo'lsa: cd webapp && npm install && npm run dev
# QOSHNI_API_TARGET=http://localhost:8000

# --- Telegram boti (8-hafta, app/bot/) ---
# Mini App'ning ommaviy HTTPS manzili — SITE_DOMAIN bilan bir xil domenda bo'lishi
# kerak (nginx statik bundle'ni shu manzilda beradi). Bo'sh bo'lsa bot ishlaydi,
# lekin menyu tugmasi va /app klaviaturasi qo'yilmaydi.
# WEBAPP_URL=https://qoshni.example.com/
# Bot sozlamalarini Telegram'ga yozish (buyruqlar + menyu tugmasi):
#   docker compose exec bot python -m app.bot.setup
